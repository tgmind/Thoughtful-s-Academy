# ============================================================
# .env.example — Copy this to .env.local and fill in your values
# NEVER commit .env.local to Git
# ============================================================

# Supabase (get from: supabase.com → your project → Settings → API)
# EDUWEB Project Gateway
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Admin security: VITE_ADMIN_CODE removed for SEC-004 remediation.
# Admin accounts are provisioned via administrative invite / database console.
# VITE_ADMIN_CODE=

# App config — customize for your institute
VITE_INSTITUTE_NAME=GRAViTON PHYSICS
VITE_INSTITUTE_TAGLINE=Learn. Grow. Succeed.
VITE_CONTACT_EMAIL=contact@example.com

# SEO — your real production domain, NO trailing slash (used for canonical,
# Open Graph, sitemap and structured-data URLs). MUST be set for SEO to work.
# Also set this in the Netlify dashboard → Site settings → Environment variables.
VITE_SITE_URL=https://gravitonacademy.com

# Web Push (browser/PWA alerts when the app is closed). Generate a key pair with:
#   npx web-push generate-vapid-keys
# Put the PUBLIC key here (and in Netlify env). The PRIVATE key goes ONLY into
# the Supabase Edge Function secrets — never in this file. Leave blank to keep
# push disabled (the app works normally without it).
VITE_VAPID_PUBLIC_KEY=

# Direct PostgreSQL connection for automated migrations
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres"
SUPABASE_PROJECT_REF="your-project-id"
